---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';

const groupPillars = [
  {
    name: 'Serinamar Group',
    role: 'Parent Group · Since 2000',
    logo: '/images/logos/group-logo.png',
    href: 'https://gruposerinamar.com/en/',
    text: 'Founded in Marbella in 2000, Serinamar Group brings together specialised companies to cover the complete property lifecycle on the Costa del Sol.',
  },
  {
    name: 'Serinamar',
    role: 'Hospitality & Real Estate',
    logo: '/images/logos/serinamar-logo.png',
    href: 'https://www.serinamar.com/',
    text: 'Leads our direct holiday rental portfolio — including Los Naranjos de Marbella — alongside residential sales and local guest reception.',
  },
  {
    name: 'Just Banús',
    role: 'Property Management & Care',
    logo: '/images/logos/just-banus-logo.png',
    href: 'https://justbanus.com/',
    text: 'Dedicated to the hands-on maintenance, professional cleaning, private laundry, and turnkey refurbishment of Marbella homes.',
  },
];
---

<BaseLayout
  title="About Iberiansun | Part of Grupo Serinamar Marbella"
  description="Learn about Iberiansun and our parent group, Grupo Serinamar — over 25 years of trusted holiday rentals and property care in Nueva Andalucía, Marbella."
  canonicalURL="https://iberiansun.es/about/"
>
  <Hero
    eyebrow="About Iberiansun · Since 2000"
    title="Over 25 Years of Trusted Marbella Hospitality"
    description="Iberiansun brings together carefully selected holiday homes in Nueva Andalucía with the strength, local team, and experience of Grupo Serinamar."
    image="/images/hero/puerto-banus-panorama.webp"
    imageAlt="Puerto Banús and Marbella coastline"
    actionLabel="Explore Destinations"
    actionHref="/destinations/"
    secondaryLabel="Contact Our Team"
    secondaryHref="/contact/"
  />

  <section class="site-section bg-[#FDFBF7]">
    <div class="site-shell">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 reveal-on-scroll">
          <p class="site-eyebrow mb-3">Our Story</p>
          <h2 class="text-3xl sm:text-4xl font-serif font-medium text-[#132238] leading-tight mb-5">
            Local knowledge. Personal service. One unified group.
          </h2>
          <div class="space-y-4 text-[#52616B] text-base leading-relaxed">
            <p>
              <strong>Iberiansun</strong> is part of <strong>Grupo Serinamar</strong>, a family-rooted property and hospitality group operating in Marbella and Puerto Banús since 2000.
            </p>
            <p>
              From our local office in <strong>Los Naranjos de Marbella</strong>, we welcome holiday guests from across the UK and Europe into carefully maintained properties across Los Naranjos, Aloha Gardens, and Dama de Noche — while also supporting non-resident owners with fiscal and administrative peace of mind.
            </p>
            <p>
              Every stay and every home benefits from our in-house cleaning, laundry, technical maintenance, and multilingual client support — so you are always in good hands.
            </p>
          </div>
        </div>
        <div class="lg:col-span-6 reveal-on-scroll stagger-2">
          <div class="rounded-2xl overflow-hidden border border-[#E4DCCF] shadow-sm">
            <img
              src="/images/destinations/townhouse-terrace.jpg"
              alt="Sunny Mediterranean terrace in Nueva Andalucía, Marbella"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section bg-[#F4EFE6] border-t border-[#E4DCCF]">
    <div class="site-shell">
      <div class="text-center max-w-3xl mx-auto mb-14 reveal-title">
        <p class="site-eyebrow mb-3">The Serinamar Group Ecosystem</p>
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-[#132238] mb-4">
          Specialised companies. One shared standard.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
        {groupPillars.map((p, idx) => (
          <article class={`holding-card reveal-on-scroll stagger-${idx + 1} bg-white border border-[#E4DCCF] rounded-2xl p-7 flex flex-col`}>
            <div class="h-24 flex items-center justify-center p-3 mb-5 bg-[#FAF8F5] rounded-xl border border-[#EAE3D9]/70">
              <img src={p.logo} alt={p.name} class="max-h-20 max-w-[200px] w-auto object-contain" loading="lazy" />
            </div>
            <p class="text-[11px] font-bold uppercase tracking-wider text-[#8C6A3E] mb-2">{p.role}</p>
            <h3 class="text-xl font-serif text-[#132238] mb-3">{p.name}</h3>
            <p class="text-sm text-[#596575] leading-relaxed mb-6 flex-grow">{p.text}</p>
            <a href={p.href} target="_blank" rel="noopener noreferrer" class="site-link self-start">
              Visit {p.name} ↗
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
