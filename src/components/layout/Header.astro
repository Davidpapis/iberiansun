---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (path: string) => pathname === (path.replace(/\/$/, '') || '/');

const groupBrands = [
  {
    name: 'Grupo Serinamar',
    href: 'https://gruposerinamar.com/en/',
    detail: 'Parent group · Holiday stays & real estate',
  },
  {
    name: 'Naranjos de Marbella',
    href: 'https://naranjosdemarbella.com/',
    detail: 'Holiday apartments in Nueva Andalucía',
  },
  {
    name: 'Just Banús',
    href: 'https://justbanus.com/',
    detail: 'Property management, maintenance & care',
  },
];
---

<header class="site-header" data-site-header>
  <div class="header-top">
    <div class="header-top-inner">
      <div class="top-location-group">
        <span class="top-group-label">SERINAMAR GROUP</span>
        <span class="top-sep">·</span>
        <span class="location">Nueva Andalucía · Marbella · Puerto Banús</span>
      </div>
      <div class="top-contact">
        <a href="tel:+34952813362">+34 952 81 33 62</a>
        <a
          class="owner-portal"
          href="https://serinamar.guestyowners.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Owner Portal <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <div class="header-main">
    <a class="brand" href="/" aria-label="Iberiansun Marbella home">
      <img
        src="/images/logos/iberiansun-logo-nobg.png"
        alt="Iberiansun — A Serinamar Group Company"
        class="brand-logo"
        width="180"
        height="62"
      />
    </a>

    <nav class="main-navigation" id="primary-navigation" aria-label="Main navigation">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
      <a href="/destinations/" aria-current={isCurrent('/destinations') ? 'page' : undefined}>Destinations</a>
      <a href="/owner-services/" aria-current={isCurrent('/owner-services') ? 'page' : undefined}>Owner Services</a>
      <a href="/about/" aria-current={isCurrent('/about') ? 'page' : undefined}>About Us</a>

      <div class="group-navigation" data-group-navigation>
        <button
          class="group-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="group-navigation-panel"
          data-group-toggle
        >
          Our Group
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <div class="group-panel" id="group-navigation-panel" hidden>
          {groupBrands.map((brand) => (
            <a href={brand.href} target="_blank" rel="noopener noreferrer">
              <span>{brand.name} ↗</span>
              <small>{brand.detail}</small>
            </a>
          ))}
        </div>
      </div>

      <a href="/contact/" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a>
    </nav>

    <div class="header-actions">
      <a
        class="book-link btn-shine"
        href="https://serinamar.guestybookings.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book Your Stay <span aria-hidden="true">↗</span>
      </a>
      <button
        class="mobile-toggle"
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false"
        aria-label="Open navigation"
        data-nav-toggle
        data-open-label="Open navigation"
        data-close-label="Close navigation"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    width: 100%;
    color: #132238;
    background: #fdfbf7;
    border-bottom: 1px solid #e8e3da;
  }
  .site-header a { color: inherit; text-decoration: none; }
  .site-header :is(a, button):focus-visible { outline: 2px solid #9b7744; outline-offset: 5px; }

  .header-top { background: #132238; color: #f5f1e9; font-size: 11px; }
  .header-top-inner {
    max-width: 1328px;
    min-height: 32px;
    padding: 0 32px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .top-location-group { display: flex; align-items: center; gap: 8px; }
  .top-group-label { font-size: 11px; font-weight: 700; letter-spacing: .15em; color: #dec7a7; }
  .top-sep { color: rgba(255, 255, 255, 0.35); }
  .location { letter-spacing: .12em; text-transform: uppercase; }
  .top-contact { display: flex; align-items: center; gap: 24px; }
  .top-contact a { white-space: nowrap; }
  .owner-portal { color: #dec7a7 !important; }
  .owner-portal span { margin-left: 4px; }

  .header-main {
    position: relative;
    max-width: 1328px;
    height: 82px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand { display: flex; align-items: center; flex-shrink: 0; }
  .brand-logo { display: block; height: 60px; width: auto; max-width: 195px; object-fit: contain; }

  .main-navigation { display: flex; align-items: center; gap: 28px; font-size: 13px; font-weight: 500; line-height: 1.4; }
  .main-navigation > a { padding: 12px 0; white-space: nowrap; }
  .main-navigation :is(a, button):hover,
  .main-navigation > a[aria-current="page"] { color: #8c6a3e; }

  .group-navigation { position: relative; }
  .group-toggle {
    border: 0;
    background: transparent;
    padding: 12px 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font: inherit;
    color: inherit;
    white-space: nowrap;
    cursor: pointer;
  }
  .group-toggle svg { transition: transform .2s ease; }
  .group-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }

  .group-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: -24px;
    width: 300px;
    padding: 12px 18px;
    background: #fdfbf7;
    border: 1px solid #e8e3da;
    border-radius: 8px;
    box-shadow: 0 14px 28px rgba(19, 34, 56, 0.08);
  }
  .group-panel[hidden] { display: none; }
  .group-panel a { display: block; padding: 11px 4px; border-bottom: 1px solid #f0ebe2; }
  .group-panel a:last-child { border-bottom: 0; }
  .group-panel a > span { display: block; font-size: 14px; font-weight: 600; color: #132238; }
  .group-panel a:hover > span { color: #8c6a3e; }
  .group-panel small { display: block; margin-top: 3px; font-size: 11px; color: #6d747c; }

  .header-actions { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .book-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 42px;
    padding: 0 22px;
    background: #132238;
    color: #fff !important;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    border-radius: 5px;
    transition: background .2s ease;
  }
  .book-link:hover { background: #203654; }
  .book-link span { color: #dec7a7; font-size: 14px; }

  .mobile-toggle { display: none; }

  @media (max-width: 1080px) {
    .header-main { height: 74px; }
    .main-navigation {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 106px);
      overflow-y: auto;
      padding: 18px 28px 26px;
      background: #fdfbf7;
      border-top: 1px solid #e8e3da;
      border-bottom: 1px solid #e8e3da;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      font-size: 15px;
    }
    .main-navigation.is-open { display: flex; }
    .main-navigation > a { padding: 13px 0; border-bottom: 1px solid #e8e3da; }
    .group-toggle { width: 100%; padding: 14px 0; justify-content: space-between; border-bottom: 1px solid #e8e3da; }
    .group-panel {
      position: static;
      width: 100%;
      padding: 4px 0 8px 14px;
      border: 0;
      border-left: 2px solid #c5a880;
      border-radius: 0;
      margin: 8px 0 12px;
      box-shadow: none;
    }
    .mobile-toggle {
      display: flex;
      width: 36px;
      height: 42px;
      padding: 10px 4px;
      border: 0;
      background: transparent;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
    }
    .mobile-toggle span { display: block; width: 24px; height: 1.5px; background: #132238; transition: transform .2s ease; }
    .mobile-toggle[aria-expanded="true"] span:first-child { transform: translateY(3.75px) rotate(45deg); }
    .mobile-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  }

  @media (max-width: 767px) {
    .header-top-inner { min-height: 29px; padding: 0 16px; }
    .header-top { font-size: 9px; }
    .owner-portal { display: none; }
    .header-main { height: 68px; padding: 0 16px; gap: 10px; }
    .brand-logo { height: 50px; }
    .book-link { padding: 0 14px; min-height: 36px; font-size: 11px; }
    .book-link span { display: none; }
  }
</style>

<script>
  function initializeHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.initialized) return;
    header.dataset.initialized = 'true';

    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const navigation = header.querySelector<HTMLElement>('#primary-navigation');
    const group = header.querySelector<HTMLElement>('[data-group-navigation]');
    const groupToggle = header.querySelector<HTMLButtonElement>('[data-group-toggle]');
    const groupPanel = header.querySelector<HTMLElement>('#group-navigation-panel');
    if (!toggle || !navigation || !group || !groupToggle || !groupPanel) return;

    const setGroupOpen = (open: boolean) => {
      groupToggle.setAttribute('aria-expanded', String(open));
      groupPanel.hidden = !open;
    };

    const setMenuOpen = (open: boolean) => {
      navigation.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) || 'Menu');
      if (!open) setGroupOpen(false);
    };

    toggle.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    groupToggle.addEventListener('click', () => setGroupOpen(groupPanel.hidden));
    navigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!group.contains(event.target)) setGroupOpen(false);
      if (!header.contains(event.target)) setMenuOpen(false);
    });

    header.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (!groupPanel.hidden) { setGroupOpen(false); groupToggle.focus(); }
      else if (toggle.getAttribute('aria-expanded') === 'true') { setMenuOpen(false); toggle.focus(); }
    });
  }

  initializeHeader();
  document.addEventListener('astro:page-load', initializeHeader);
</script>
